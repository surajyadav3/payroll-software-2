# --- eTimeTrackLite local database ---
# Run on the same PC (or LAN) as the ESSL software install.
#
# DB_TYPE=mysql (default) — a single growing punch-log table. Find the values
# below with whatever MySQL client is on that PC (MySQL Workbench, HeidiSQL,
# or the command-line `mysql` client).
#
# DB_TYPE=mssql — most SQL Server–based eTimeTrackLite installs. Punch logs
# are split into one table per calendar month (e.g. DeviceLogs_8_2026), so
# ESSL_DB_TABLE is unused for mssql — set ESSL_DB_TABLE_PREFIX instead and the
# agent computes the current month's table name itself. Confirm the instance
# name, database name, and table/column names with SQL Server Management
# Studio first (see README).
DB_TYPE=mysql

ESSL_DB_HOST=localhost
ESSL_DB_PORT=3306
# mssql only — the named instance, e.g. SQLEXPRESS (server becomes HOST\INSTANCE).
# Leave blank for a default (unnamed) instance.
ESSL_DB_INSTANCE=
ESSL_DB_NAME=eTimeTrackLite
ESSL_DB_USER=root
ESSL_DB_PASSWORD=

# Table/column names — confirm these against the real DB before first run
# (see README "Confirming your schema"). These defaults match a standard
# eTimeTrackLite install.
ESSL_DB_TABLE=DeviceLogs
ESSL_DB_TABLE_PREFIX=DeviceLogs
ESSL_DB_COL_USER_ID=UserId
ESSL_DB_COL_LOG_TIME=LogDate
ESSL_DB_COL_DIRECTION=Direction
# mssql only — the identity/primary key column, used as the sync checkpoint
# instead of a timestamp since each month's table restarts its own numbering.
ESSL_DB_COL_ID=DeviceLogId
# Comma-separated values in the direction column that mean "punch in"; anything else is "out".
ESSL_DIRECTION_IN_VALUES=IN,I,0

# --- Worked example: a SQL Server install (matches Raniwala's setup) ---
# DB_TYPE=mssql
# ESSL_DB_HOST=localhost
# ESSL_DB_INSTANCE=SQLEXPRESS
# ESSL_DB_NAME=eTimetracklite1
# ESSL_DB_USER=crewcore_sync_reader
# ESSL_DB_PASSWORD=<the password set for that login>
# ESSL_DB_TABLE_PREFIX=DeviceLogs
# ESSL_DB_COL_USER_ID=UserId
# ESSL_DB_COL_LOG_TIME=LogDate
# ESSL_DB_COL_DIRECTION=Direction
# ESSL_DB_COL_ID=DeviceLogId
# ESSL_DIRECTION_IN_VALUES=in,IN,I,0
# CREWCORE_ESSL_PUNCH_URL=https://<project-ref>.supabase.co/functions/v1/essl-punch
# CREWCORE_DEVICE_API_KEY=<api_key from the essl_devices row>
# CREWCORE_SUPABASE_ANON_KEY=<CrewCore project's anon key>

# --- CrewCore ---
# Full URL of the deployed essl-punch Edge Function, e.g.
# https://<project-ref>.supabase.co/functions/v1/essl-punch
CREWCORE_ESSL_PUNCH_URL=
# The api_key from the essl_devices row created for this device/tenant.
CREWCORE_DEVICE_API_KEY=
# CrewCore's Supabase anon key (from Project Settings -> API on the CrewCore
# project — NOT a secret specific to this device). Required by the Supabase
# Edge Functions gateway itself as a separate auth layer from the device
# api_key above; requests without it fail with a 401 before essl-punch's own
# code runs at all.
CREWCORE_SUPABASE_ANON_KEY=

# How often to poll for new punches, in seconds.
ESSL_SYNC_INTERVAL_SECONDS=60
